# ============================================================
# AxeL Job - Production environment variables
# Copy to .env and fill in your values before deploying
# ============================================================

# --- Application ---
ENVIRONMENT=production

# --- Google Gemini AI ---
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Optionnel : URI Postgres (Dashboard > Database). Accès direct + repli auto sur l’API REST si la DB est injoignable.
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_JWT_SECRET=

# Docker / perf (optionnel)
# UVICORN_WORKERS=1
# THREAD_POOL_MAX_WORKERS=4
# USER_PLAN_CACHE_TTL_SEC=30

# --- Public URLs (HTTPS in production!) ---
# Backend API URL (used for CV preview iframe <base> tag)
# Set to your backend URL if frontend and backend are on different domains
# Leave empty if nginx proxies /api/ to the backend (same origin)
CV_BOT_API_BASE_URL=

# Frontend URL (used for Stripe redirect and CORS)
CV_BOT_FRONTEND_URL=https://cv.yourdomain.com

# --- Stripe (optional: subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe template personnalisé (one-time 5 €) + Resend (email après paiement) ---
STRIPE_PRICE_ID_TEMPLATE_PERSO=
RESEND_API_KEY=
RESEND_FROM_EMAIL=AxeL Job <onboarding@resend.dev>
SUPPORT_EMAIL=contact@axelproject.fr
# Emails pouvant envoyer des réponses support depuis l'app (vide = seul SUPPORT_EMAIL peut)
SUPPORT_ADMIN_EMAILS=

# --- HTTP Host header (optionnel) : liste CSV des hôtes publics autorisés (ex. api.job.axelproject.fr)
# Vide = pas de filtre. Le backend ajoute toujours localhost / 127.0.0.1 (healthcheck Docker, curl local).
# TRUSTED_HOSTS=api.votredomaine.fr

# --- Production sans Supabase (déconseillé) : données locales partagées « default » - uniquement si vous savez ce que vous faites
# ALLOW_LOCAL_DATA_IN_PRODUCTION=1

# --- Metrics auth (optional: protect /metrics endpoint) ---
METRICS_AUTH_TOKEN=

# --- Monitoring / alertes email (Resend, même clé que ci-dessus) ---
# MONITORING_ALERT_ENABLED=1
# MONITORING_ALERT_EMAILS=toi@domaine.fr
# Seuils (optionnel) : CPU/RAM système, rafale 5xx, lenteurs, pic CPU vs moyenne
# MONITORING_ALERT_CPU_PCT=85
# MONITORING_ALERT_MEM_PCT=88
# MONITORING_ALERT_MIN_INTERVAL_SEC=900
# MONITORING_ALERT_5XX_WINDOW_SEC=300
# MONITORING_ALERT_5XX_THRESHOLD=15
# MONITORING_ALERT_SLOW_REQUEST_SEC=8
# MONITORING_ALERT_SLOW_COUNT_THRESHOLD=25
# Fenêtre « utilisateurs actifs » (JWT vu sur une requête API) et cible CPU pour l’estimation capacité
# MONITORING_ACTIVE_USER_TTL_SEC=600
# MONITORING_CAPACITY_TARGET_CPU_PCT=70

# --- Logo API ---
LOGO_DEV_TOKEN=

# --- Frontend build args (passed at docker build time) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
