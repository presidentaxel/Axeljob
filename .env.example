# ============================================================
# AxeL Job - Single env example (dev + production)
# Copy to .env then set values according to ENVIRONMENT
# ============================================================

# Global mode: development | production
ENVIRONMENT=development

# --- Google Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL_LINKEDIN=gemini-2.0-flash
# GEMINI_MODEL_IMPORT=gemini-2.5-flash-lite
# GEMINI_MODELS_VISION=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-1.5-flash,gemini-1.5-pro
# GEMINI_BUDGET_EUR=10
# GEMINI_USD_PER_EUR=1.08

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_PG_POOL_MAX=8
# SUPABASE_PG_CONNECT_TIMEOUT=10

# --- Public URLs ---
# In production, set HTTPS URLs
CV_BOT_API_BASE_URL=
CV_BOT_FRONTEND_URL=

# --- Frontend build args (Docker build) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AXEL_GTM_ID=
# VITE_APP_URL=

# --- Stripe / billing (abonnement Pro 10EUR/mois) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- Email / support ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=AxeL Job <onboarding@resend.dev>
SUPPORT_EMAIL=
SUPPORT_ADMIN_EMAILS=

# --- Runtime / perf ---
# USER_PLAN_CACHE_TTL_SEC=30
# THREAD_POOL_MAX_WORKERS=4
# JWT_LEEWAY_SECONDS=120
# AUTH_USER_EXIST_CACHE_TTL_SEC=45

# --- PDF engine ---
# CV_BOT_PDF_ENGINE=weasyprint
# CV_BOT_PDF_CHROMIUM_NO_SANDBOX=1
# CV_BOT_PDF_CHROMIUM_TIMEOUT_MS=90000
# CV_BOT_PDF_CHROMIUM_IDLE_TIMEOUT_SEC=600
# CV_BOT_PDF_CHROMIUM_POOL_SIZE=1
# CV_BOT_PDF_CHROMIUM_ARGS=
# CV_BOT_PDF_CHROMIUM_VIEWPORT_HEIGHT=20000
WEASYPRINT_DLL_DIRECTORIES=
# CV_BOT_MEM_TRIM_LOG=0

# --- Security / ops ---
# TRUSTED_HOSTS=api.votredomaine.fr
METRICS_AUTH_TOKEN=
# ALLOW_LOCAL_DATA_IN_PRODUCTION=1

# --- Monitoring alerts ---
# MONITORING_ALERT_ENABLED=1
# MONITORING_ALERT_EMAILS=toi@domaine.fr
# MONITORING_ALERT_CPU_PCT=85
# MONITORING_ALERT_MEM_PCT=88
# MONITORING_ALERT_MIN_INTERVAL_SEC=900
# MONITORING_ALERT_5XX_WINDOW_SEC=300
# MONITORING_ALERT_5XX_THRESHOLD=15
# MONITORING_ALERT_SLOW_REQUEST_SEC=8
# MONITORING_ALERT_SLOW_COUNT_THRESHOLD=25
# MONITORING_ALERT_CPU_REQUIRED_TICKS=3
# MONITORING_ACTIVE_USER_TTL_SEC=600
# MONITORING_CAPACITY_TARGET_CPU_PCT=70
# MONITORING_CAPACITY_IDLE_CPU_BASELINE_PCT=2
# MONITORING_CAPACITY_MIN_MARGINAL_CPU_SAMPLE_PCT=1
# MONITORING_CAPACITY_EMA_ALPHA=0.14
# MONITORING_CAPACITY_MIN_CPU_SAMPLE_PCT=4
# MONITORING_CAPACITY_SAMPLE_MAX=96

# --- Local export path ---
CV_BOT_EXPORT_BASE=

# --- Optional ---
LOGO_DEV_TOKEN=
# LOGO_DEV_PUBLISHABLE_KEY=
# EVENT_LOG_QUEUE_MAX=10000
# EVENT_LOG_BATCH_SIZE=50
# EVENT_LOG_BATCH_WAIT_SEC=0.5
# EVENT_LOG_SYNC=0