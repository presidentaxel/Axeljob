{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && npm run build:brand-assets && vite build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-token-drift.mjs",
    "build:brand-assets": "node scripts/generate-brand-assets.mjs",
    "build:favicon-webp": "node scripts/favicon-webp.mjs",
    "lint": "eslint .",
    "lint:css-hex": "node scripts/lint-css-hex.mjs",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dompurify": "^3.4.13",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.1"
  }
}
