# Clé API Google AI (Gemini)
# Obtenir une clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Budget Gemini par compte (€) - au-delà, requêtes refusées (429) sans afficher "tokens" à l'utilisateur (défaut : 10)
# GEMINI_BUDGET_EUR=10
# Taux USD/EUR pour comparer le coût API (USD) au budget (défaut : 1.08)
# GEMINI_USD_PER_EUR=1.08

# Dossier racine pour l'export des dossiers candidature (sous-dossiers "Entreprise - Poste")
# Exemple Windows : C:\Users\Vous\Candidatures
# Exemple Linux/macOS : /home/vous/candidatures
CV_BOT_EXPORT_BASE=

# Moteur PDF CV : weasyprint (défaut) ou chromium (Playwright — rendu proche du navigateur)
# CV_BOT_PDF_ENGINE=weasyprint
#
# Docker Compose : après modification de cette ligne, recréer le backend pour appliquer l’env :
#   docker compose up -d --force-recreate backend
# (un simple restart ne recharge pas toujours les variables injectées.)
#
# Vérifier : curl -s http://localhost:3000/health | findstr cv_pdf_engine   (ou ouvrir /health dans le navigateur)
# Logs au démarrage du backend : [cv-bot] startup: PDF engine=...
#
# Avec chromium : `playwright install chromium` (inclus dans l’image Docker backend au build)
# Sandbox : désactivée si /.dockerenv ; sinon : CV_BOT_PDF_CHROMIUM_NO_SANDBOX=1
# CV_BOT_PDF_CHROMIUM_TIMEOUT_MS=90000
# CV_BOT_PDF_CHROMIUM_ARGS=
# Hauteur viewport pour le layout avant impression (défaut 20000 px). Trop bas ≈ 1 page A4 → sidebar tronquée en PDF.
# CV_BOT_PDF_CHROMIUM_VIEWPORT_HEIGHT=20000
#
# Chromium charge images/CSS via CV_BOT_API_BASE_URL : en Docker, le conteneur doit joindre cette URL.
# Exemple (réseau compose, depuis le navigateur utilisateur tu restes sur localhost:3000) :
# CV_BOT_API_BASE_URL=http://backend:8000

# Windows uniquement : chemin vers les DLL Pango/GTK pour WeasyPrint (génération PDF)
# Après installation de MSYS2 : pacman -S mingw-w64-x86_64-pango
# Exemple : C:\msys64\mingw64\bin
WEASYPRINT_DLL_DIRECTORIES=

# Supabase (optionnel) : si défini, le CV de base et les candidatures sont stockés dans Supabase
# Sinon : cv_base.json + dossier adaptations/ (comportement par défaut)
# Créer les tables avec backend/supabase_schema.sql dans le SQL Editor Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optionnel : connexion PostgreSQL directe (même projet). Réduit la latence vs l'API PostgREST.
# Dashboard > Project Settings > Database > Connection string > URI (Session pooler recommandé sur un VPS).
# En cas d'échec, le backend retombe automatiquement sur le client Supabase (REST).
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_PG_POOL_MAX=8
# SUPABASE_PG_CONNECT_TIMEOUT=10

# Perf (backend) : cache mémoire user_plans en secondes (0 = désactivé), pool threads WeasyPrint/async
# USER_PLAN_CACHE_TTL_SEC=30
# THREAD_POOL_MAX_WORKERS=4

# Secret JWT Supabase (optionnel) : pour identifier l'utilisateur connecté côté API (Dashboard > API > JWT Secret)
SUPABASE_JWT_SECRET=
# Tolérance iat/exp en secondes (défaut 120) - si erreur « token is not yet valid (iat) », sync l’horloge Windows ou augmente cette valeur
# JWT_LEEWAY_SECONDS=120
# Cache « utilisateur Auth existe » (secondes, défaut 45) : après suppression d’un compte dans Supabase, l’API peut encore accepter le JWT jusqu’à ce délai max par uid
# AUTH_USER_EXIST_CACHE_TTL_SEC=45

# URL publique du backend (pour l’iframe de prévisualisation du CV : CSS et images)
# Doit être l’URL que le navigateur utilise pour appeler l’API (ex. http://localhost:8000)
CV_BOT_API_BASE_URL=

# Logo entreprise : clé PUBLISHABLE (pk_...) sur https://www.logo.dev/dashboard - pas la secret (sk_) !
LOGO_DEV_TOKEN=