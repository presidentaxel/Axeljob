# URL du backend FastAPI (obligatoire en dev si le front tourne sur un autre port)
VITE_API_URL=http://localhost:8000

# Supabase (optionnel) : pour connexion et stockage du CV par utilisateur
# Créer un projet sur supabase.com, récupérer URL et anon key (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Tag Manager (job.axelproject.fr) : ID du type GTM-XXXXXXX - injecté dans dist/analytics-config.js au build
VITE_AXEL_GTM_ID=

# Sentry (AXE-369) : DSN projet axel-job-frontend. Vide = no-op. En Docker : build args, pas runtime.
# VITE_SENTRY_ENVIRONMENT = production | staging (pas MODE). Rebuild après changement.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=

# Débloquer l’espace /app sur téléphone en production (par défaut : bloqué sous 768px). Valeurs : true ou 1
# VITE_ALLOW_MOBILE_APP=true
