# ============================================================
# AxeL Job — Production environment variables
# Copy to .env and fill in your values before deploying
# ============================================================

# --- Application ---
ENVIRONMENT=production

# --- Google Gemini AI ---
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Public URLs (HTTPS in production!) ---
# Backend API URL (used for CV preview iframe <base> tag)
# Set to your backend URL if frontend and backend are on different domains
# Leave empty if nginx proxies /api/ to the backend (same origin)
CV_BOT_API_BASE_URL=

# Frontend URL (used for Stripe redirect and CORS)
CV_BOT_FRONTEND_URL=https://cv.yourdomain.com

# --- Stripe (optional: subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- Metrics auth (optional: protect /metrics endpoint) ---
METRICS_AUTH_TOKEN=

# --- Logo API ---
LOGO_DEV_TOKEN=

# --- Frontend build args (passed at docker build time) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
