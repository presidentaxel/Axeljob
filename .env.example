# Clé API Google AI (Gemini)
# Obtenir une clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Dossier racine pour l'export des dossiers candidature (sous-dossiers "Entreprise - Poste")
# Exemple Windows : C:\Users\Vous\Candidatures
# Exemple Linux/macOS : /home/vous/candidatures
CV_BOT_EXPORT_BASE=

# Windows uniquement : chemin vers les DLL Pango/GTK pour WeasyPrint (génération PDF)
# Après installation de MSYS2 : pacman -S mingw-w64-x86_64-pango
# Exemple : C:\msys64\mingw64\bin
WEASYPRINT_DLL_DIRECTORIES=

# Supabase (optionnel) : si défini, le CV de base et les candidatures sont stockés dans Supabase
# Sinon : cv_base.json + dossier adaptations/ (comportement par défaut)
# Créer les tables avec backend/supabase_schema.sql dans le SQL Editor Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Secret JWT Supabase (optionnel) : pour identifier l'utilisateur connecté côté API (Dashboard > API > JWT Secret)
SUPABASE_JWT_SECRET=

# URL publique du backend (pour l’iframe de prévisualisation du CV : CSS et images)
# Doit être l’URL que le navigateur utilise pour appeler l’API (ex. http://localhost:8000)
CV_BOT_API_BASE_URL=

# Logo entreprise : clé PUBLISHABLE (pk_...) sur https://www.logo.dev/dashboard - pas la secret (sk_) !
LOGO_DEV_TOKEN=