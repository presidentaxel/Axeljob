{
  "$description": "AxeL Job design tokens (DTCG-inspired). UI code consumes semantic tokens only — never primitives.",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "primitive" },
      "50": { "$type": "color", "$value": "#eeece7" },
      "100": { "$type": "color", "$value": "#f2f2f2" },
      "200": { "$type": "color", "$value": "#e5e7eb" },
      "300": { "$type": "color", "$value": "#d9d9dd" },
      "500": { "$type": "color", "$value": "#93939f" },
      "600": { "$type": "color", "$value": "#75758a" },
      "700": { "$type": "color", "$value": "#616161" },
      "800": { "$type": "color", "$value": "#212121" },
      "900": { "$type": "color", "$value": "#17171c" },
      "950": { "$type": "color", "$value": "#000000" }
    },
    "green": {
      "50": { "$type": "color", "$value": "#edfce9" },
      "800": { "$type": "color", "$value": "#005246" },
      "900": { "$type": "color", "$value": "#003c33" }
    },
    "navy": {
      "900": { "$type": "color", "$value": "#071829" }
    },
    "blue": {
      "50": { "$type": "color", "$value": "#f1f5ff" },
      "400": { "$type": "color", "$value": "#4c6ee6" },
      "500": { "$type": "color", "$value": "#1863dc" }
    },
    "coral": {
      "300": { "$type": "color", "$value": "#ffad9b" },
      "500": { "$type": "color", "$value": "#ff7759" }
    },
    "purple": {
      "500": { "$type": "color", "$value": "#9b60aa" }
    },
    "red": {
      "50": { "$type": "color", "$value": "#fef2f2" },
      "700": { "$type": "color", "$value": "#b30000" },
      "800": { "$type": "color", "$value": "#8a0000" }
    },
    "amber": {
      "600": { "$type": "color", "$value": "#d97706" }
    },
    "bg": {
      "default": { "$type": "color", "$value": "{color.neutral.0}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.50}" },
      "inverse": { "$type": "color", "$value": "{color.green.900}" },
      "inverse-alt": { "$type": "color", "$value": "{color.navy.900}" },
      "accent": { "$type": "color", "$value": "{color.blue.50}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.neutral.800}" },
      "muted": { "$type": "color", "$value": "{color.neutral.700}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.500}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.0}" },
      "link": { "$type": "color", "$value": "{color.blue.500}" },
      "danger": { "$type": "color", "$value": "{color.red.700}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.300}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.200}" },
      "focus": { "$type": "color", "$value": "{color.blue.400}" },
      "input-focus": { "$type": "color", "$value": "{color.purple.500}" }
    },
    "action": {
      "primary": {
        "bg": { "$type": "color", "$value": "{color.neutral.900}" },
        "bg-hover": { "$type": "color", "$value": "{color.neutral.800}" },
        "bg-active": { "$type": "color", "$value": "{color.neutral.950}" },
        "bg-disabled": { "$type": "color", "$value": "{color.neutral.200}" },
        "fg": { "$type": "color", "$value": "{color.neutral.0}" },
        "fg-disabled": { "$type": "color", "$value": "{color.neutral.500}" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "transparent" },
        "bg-hover": { "$type": "color", "$value": "{color.neutral.50}" },
        "bg-active": { "$type": "color", "$value": "{color.neutral.100}" },
        "fg": { "$type": "color", "$value": "{color.neutral.900}" },
        "border": { "$type": "color", "$value": "{color.neutral.900}" }
      },
      "tertiary": {
        "bg": { "$type": "color", "$value": "transparent" },
        "bg-hover": { "$type": "color", "$value": "{color.neutral.50}" },
        "fg": { "$type": "color", "$value": "{color.neutral.800}" },
        "fg-muted": { "$type": "color", "$value": "{color.neutral.500}" }
      },
      "ghost": {
        "bg": { "$type": "color", "$value": "transparent" },
        "fg": { "$type": "color", "$value": "{color.neutral.500}" },
        "fg-hover": { "$type": "color", "$value": "{color.neutral.800}" }
      },
      "link": {
        "fg": { "$type": "color", "$value": "{color.blue.500}" },
        "fg-hover": { "$type": "color", "$value": "{color.blue.400}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{color.red.700}" },
        "bg-hover": { "$type": "color", "$value": "{color.red.800}" },
        "fg": { "$type": "color", "$value": "{color.neutral.0}" }
      },
      "success": {
        "bg": { "$type": "color", "$value": "{color.green.900}" },
        "bg-hover": { "$type": "color", "$value": "{color.green.800}" },
        "fg": { "$type": "color", "$value": "{color.neutral.0}" }
      },
      "inverse": {
        "bg": { "$type": "color", "$value": "{color.neutral.0}" },
        "bg-hover": { "$type": "color", "$value": "{color.blue.50}" },
        "overlay-hover": { "$type": "color", "$value": "rgb(255 255 255 / 0.12)" },
        "fg": { "$type": "color", "$value": "{color.neutral.900}" }
      }
    },
    "feedback": {
      "error": { "$type": "color", "$value": "{color.red.700}" },
      "error-subtle": { "$type": "color", "$value": "{color.red.50}" },
      "warning": { "$type": "color", "$value": "{color.amber.600}" },
      "success": { "$type": "color", "$value": "{color.green.900}" },
      "success-subtle": { "$type": "color", "$value": "{color.green.50}" },
      "info": { "$type": "color", "$value": "{color.blue.500}" }
    },
    "accent": {
      "editorial": { "$type": "color", "$value": "{color.coral.500}" },
      "editorial-soft": { "$type": "color", "$value": "{color.coral.300}" }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": "CohereText, \"Space Grotesk\", Inter, ui-sans-serif, system-ui"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "\"Unica77 Cohere Web\", Inter, Arial, ui-sans-serif, system-ui"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "CohereMono, Arial, ui-sans-serif, system-ui"
      }
    },
    "size": {
      "display-xl": { "$type": "dimension", "$value": "96px" },
      "display-lg": { "$type": "dimension", "$value": "72px" },
      "display-md": { "$type": "dimension", "$value": "60px" },
      "heading-xl": { "$type": "dimension", "$value": "48px" },
      "heading-lg": { "$type": "dimension", "$value": "32px" },
      "heading-md": { "$type": "dimension", "$value": "24px" },
      "body-lg": { "$type": "dimension", "$value": "18px" },
      "body-md": { "$type": "dimension", "$value": "16px" },
      "label-md": { "$type": "dimension", "$value": "14px" },
      "label-sm": { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" }
    },
    "line-height": {
      "display": { "$value": "1" },
      "heading": { "$value": "1.2" },
      "feature": { "$value": "1.3" },
      "body-lg": { "$value": "1.4" },
      "body": { "$value": "1.5" },
      "button": { "$value": "1.71" }
    },
    "letter-spacing": {
      "display-xl": { "$type": "dimension", "$value": "-1.92px" },
      "display-lg": { "$type": "dimension", "$value": "-1.44px" },
      "display-md": { "$type": "dimension", "$value": "-1.2px" },
      "heading-xl": { "$type": "dimension", "$value": "-0.48px" },
      "heading-lg": { "$type": "dimension", "$value": "-0.32px" },
      "none": { "$value": "0" },
      "mono": { "$type": "dimension", "$value": "0.28px" }
    }
  },
  "space": {
    "xxs": { "$type": "dimension", "$value": "2px" },
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "xxl": { "$type": "dimension", "$value": "32px" },
    "section": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "22px" },
    "xl": { "$type": "dimension", "$value": "30px" },
    "action": { "$type": "dimension", "$value": "32px", "$description": "CTA shape. Not a button variant." },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "size": {
    "button": {
      "sm": { "$type": "dimension", "$value": "32px" },
      "md": { "$type": "dimension", "$value": "40px" },
      "lg": { "$type": "dimension", "$value": "48px" }
    },
    "touch": {
      "min": {
        "$type": "dimension",
        "$value": "44px",
        "$description": "Minimum CTA hit area. Consumed by .ds-button--sm and .ds-button--md below 768px."
      }
    }
  },
  "z": {
    "base": { "$value": "0" },
    "dropdown": { "$value": "100" },
    "sticky": { "$value": "200" },
    "modal": { "$value": "400" },
    "toast": { "$value": "500" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "280ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "layout": {
    "container": {
      "app": { "$type": "dimension", "$value": "1120px" }
    },
    "gutter": {
      "md": { "$type": "dimension", "$value": "24px" }
    },
    "breakpoint": {
      "small-mobile": { "$type": "dimension", "$value": "425px" },
      "mobile": { "$type": "dimension", "$value": "640px" },
      "large-mobile": { "$type": "dimension", "$value": "768px" },
      "tablet": { "$type": "dimension", "$value": "1024px" },
      "desktop": { "$type": "dimension", "$value": "1440px" }
    }
  }
}
